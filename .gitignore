# ============================================
# 数据输出目录（走移动硬盘/网盘同步，不进 git）
# ============================================
/convert_project10/out/
/lidar_anchored_refiner/work/

# ROS / SLAM 数据文件（点云、传感器记录、数组缓存）
*.bag
*.db3
*.npy
*.npz
*.pcd
*.ply

# ============================================
# 嵌套的上游仓库 git 历史（源码按普通文件提交）
# ============================================
.git/

# ============================================
# C++ / ROS 构建产物
# ============================================
build/
devel/
install/
log/
.vs/
*.o
*.so
*.a

# ============================================
# 模型权重文件（走其他渠道同步，不进 git）
# ============================================
*.onnx
*.onnx.*
*.pth
*.pt
*.ckpt
*.h5
*.engine

# ============================================
# 依赖包 / 工具缓存 / 内部状态
# ============================================
node_modules/
.cache/
.mimosa/

# ============================================
# Python / IDE / Office 临时文件
# ============================================
__pycache__/
*.pyc
.ipynb_checkpoints/
.idea/
.vscode/
~$*

# 嵌套上游仓库的 git 元数据备份（改回 .git 即可恢复对比上游能力）
.git.bak/

# FAST-LIVO2 运行日志与输出
/FAST-LIVO2/Log/
